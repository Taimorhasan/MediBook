<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- FCM permissions -->
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <permission android:name="com.example.medibook.permission.C2D_MESSAGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.example.medibook.permission.C2D_MESSAGE" />

    <application
        android:name=".MedibookApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediBook">

        <!-- Common Activities -->
        <activity
            android:name=".activities.common.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MediBook">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activities.common.PortalSelectionActivity" />

        <!-- Auth Activities - Patient -->
        <activity android:name=".activities.auth.LoginActivity" />
        <activity android:name=".activities.auth.SignupActivity" />
        <activity android:name=".activities.user.UserLoginActivity" />

        <!-- Auth Activities - Doctor -->
        <activity android:name=".activities.auth.DoctorLoginActivity" />
        <activity android:name=".activities.auth.DoctorSignupActivity" />

         <!-- User Activities -->
         <activity android:name=".activities.user.UserHomeActivity" />
         <activity android:name=".activities.user.DoctorListActivity" />
         <activity android:name=".activities.user.DoctorProfileActivity" />
         <activity android:name=".activities.user.BookAppointmentActivity" />
         <activity android:name=".activities.user.AppointmentsActivity" />
         <activity android:name=".activities.user.BookingsListActivity" />
         
         <!-- ADDED ALERTS ACTIVITY HERE -->
         <activity 
            android:name=".activities.user.AlertsActivity" 
            android:exported="false" 
            android:theme="@style/Theme.MediBook.NoActionBar" />
            
         <activity android:name=".activities.user.NotificationsActivity" />
         <activity android:name=".activities.user.ProfileActivity" />
         <activity android:name=".activities.user.EditPatientProfileActivity" />
         <activity android:name=".activities.user.PatientProfileViewActivity" />

        <!-- Admin Activities -->
        <activity android:name=".activities.admin.AdminLoginActivity" />
        <activity android:name=".activities.admin.AdminDashboardActivity" />
        <activity android:name=".activities.admin.ManageDoctorsActivity" />
        <activity android:name=".activities.admin.ManageAppointmentsActivity" />
        <activity android:name=".activities.admin.PatientRecordsActivity" />

        <!-- Doctor Activities -->
        <activity android:name=".activities.doctor.DoctorDashboardActivity" />
        <activity android:name=".activities.doctor.EditDoctorProfileActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MediBook">
        </activity>

        <!-- FCM Service -->
        <service
            android:name=".services.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>