<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@android:color/white"
            app:navigationIcon="@android:drawable/ic_media_previous"
            app:title="Doctor Info"
            app:titleTextColor="#2563FF"
            app:titleTextAppearance="@style/TextAppearance.AppCompat.Title">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingEnd="56dp"
                android:text="Doctor Info"
                android:textColor="#2563FF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </androidx.appcompat.widget.Toolbar>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sort By   A-Z   ★   ♡   ♀   ♂"
                    android:textColor="#4B5563"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="274dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_doctor_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="156dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/doctor_image_view"
                            android:layout_width="136dp"
                            android:layout_height="136dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:padding="12dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_medical_kit"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_MediBook_Circle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="136dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="top"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_pill_blue"
                                android:gravity="center"
                                android:text="⚕  15 years\nexperience"
                                android:textColor="@android:color/white"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/doctor_bio_tv"
                                android:layout_width="match_parent"
                                android:layout_height="96dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_pill_blue"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="Focus: The impact of hormonal imbalances on skin conditions, specializing in acne, hirsutism, and other skin disorders."
                                android:textColor="@android:color/white"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_white_panel"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/doctor_name_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Dr. Alexander Bennett, Ph.D."
                            android:textColor="#2563FF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/doctor_specialty_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Dermato-Genetics"
                            android:textColor="#1F2937"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/doctor_rating_tv"
                            android:layout_width="46dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_icon_circle_white"
                            android:gravity="center"
                            android:text="★ 5"
                            android:textColor="#2563FF"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_icon_circle_white"
                            android:gravity="center"
                            android:text="40"
                            android:textColor="#2563FF"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_icon_circle_white"
                            android:gravity="center"
                            android:text="Mon-Sat / 9:00AM - 5:00PM"
                            android:textColor="#2563FF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/doctor_experience_tv"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Profile"
                    android:textColor="#2563FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Experienced dermatologist focused on practical, patient-centered care. Reviews symptoms, history, treatment goals, and follow-up plans with calm, clear guidance."
                    android:textColor="#1F2937"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Career Path"
                    android:textColor="#2563FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Board-certified medical specialist with clinical experience across diagnosis, prevention, and long-term treatment planning."
                    android:textColor="#1F2937"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Highlights"
                    android:textColor="#2563FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Known for concise consultations, clear treatment notes, and careful follow-up for skin health, cosmetic concerns, and chronic conditions."
                    android:textColor="#1F2937"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <Button
                    android:id="@+id/profile_book_button"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:gravity="center"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_bottom_nav_doctor"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⌂"
                    android:textColor="@android:color/white"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="♡"
                    android:textColor="@android:color/white"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="♙"
                    android:textColor="@android:color/white"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="▦"
                    android:textColor="@android:color/white"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
