<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".activities.common.PortalSelectionActivity">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Top Bar -->
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:layout_marginBottom="32dp">
    
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <!-- Icon: Tint removed because vector is already blue -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_medical_kit" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</RelativeLayout>

            <!-- Header Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/portal_title"
                android:textSize="28sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/portal_subtitle"
                android:textSize="15sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="32dp"
                android:lineSpacingExtra="4dp"/>

            <!-- Patient Portal Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PORTAL A"
                        android:textSize="10sp"
                        android:textColor="#9CA3AF"
                        android:textStyle="bold"
                        android:layout_gravity="end"
                        android:layout_marginBottom="16dp"/>
                        
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:tint="#0066CC"
                        android:layout_marginBottom="16dp"
                        android:background="#E0F2FE"
                        android:padding="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patient_title"
                        android:textSize="20sp"
                        android:textColor="#111827"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patient_desc"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="24dp"/>

                    <Button
                        android:id="@+id/btnPatient"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/btn_patient"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_primary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Doctor Portal Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PORTAL B"
                        android:textSize="10sp"
                        android:textColor="#9CA3AF"
                        android:textStyle="bold"
                        android:layout_gravity="end"
                        android:layout_marginBottom="16dp"/>
                        
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_today"
                        android:tint="#0066CC"
                        android:layout_marginBottom="16dp"
                        android:background="#E0F2FE"
                        android:padding="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/doctor_title"
                        android:textSize="20sp"
                        android:textColor="#111827"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/doctor_desc"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="24dp"/>

                    <Button
                        android:id="@+id/btnDoctor"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/btn_doctor"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_primary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Admin Portal Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="32dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PORTAL C"
                        android:textSize="10sp"
                        android:textColor="#9CA3AF"
                        android:textStyle="bold"
                        android:layout_gravity="end"
                        android:layout_marginBottom="16dp"/>
                        
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_lock_lock"
                        android:tint="#0066CC"
                        android:layout_marginBottom="16dp"
                        android:background="#E0F2FE"
                        android:padding="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_title"
                        android:textSize="20sp"
                        android:textColor="#111827"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_desc"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="24dp"/>

                    <Button
                        android:id="@+id/btnAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/btn_admin"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_primary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Footer Text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_to_medibook"
                    android:textColor="#6B7280"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvContactSupport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_support"
                    android:textColor="#0066CC"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    android:tint="#9CA3AF"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hipaa_compliant"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="16dp"/>
                
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:tint="#9CA3AF"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/encryption_256"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>