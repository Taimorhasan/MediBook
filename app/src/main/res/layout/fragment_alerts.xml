<?xml version="1.0" encoding="utf-8"?>
<!-- Inbox: conversations and booking alerts behind a Messages / Alerts switch. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/nav_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_inbox"
                android:textAppearance="@style/TextAppearance.MediBook.Headline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alerts_read_all"
                style="@style/Widget.MediBook.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/mark_all_read"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/inbox_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:checkedButton="@id/inbox_messages"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inbox_messages"
                style="@style/Widget.MediBook.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/messages" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inbox_alerts"
                style="@style/Widget.MediBook.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_alerts" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <include
            android:id="@+id/alerts_state"
            layout="@layout/view_state" />

        <include
            android:id="@+id/inbox_chats"
            layout="@layout/view_board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <include
            android:id="@+id/alerts_board"
            layout="@layout/view_board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
