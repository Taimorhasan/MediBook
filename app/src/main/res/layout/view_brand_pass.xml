<?xml version="1.0" encoding="utf-8"?>
<!-- The MediBook pass that opens sign-in and sign-up: an ink pass in the app's own pass shape. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/brand_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/mb_ink"
    app:cardCornerRadius="22dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/brand_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/logo_description"
                    android:src="@drawable/ic_logo"
                    app:tint="@color/mb_on_ink" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_extrabold"
                    android:text="@string/app_name"
                    android:textColor="@color/mb_on_ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/brand_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono_medium"
                    android:text="@string/brand_tag"
                    android:textColor="@color/mb_on_ink"
                    android:alpha="0.6"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/brand_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/manrope_extrabold"
                android:letterSpacing="-0.02"
                app:lineHeight="38sp"
                android:text="@string/brand_title"
                android:textColor="@color/mb_on_ink"
                android:textSize="30sp" />
        </LinearLayout>

        <View
            android:id="@+id/brand_tear"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:alpha="0.35"
            android:background="@drawable/bg_tear"
            android:backgroundTint="@color/mb_on_ink"
            android:layerType="software" />

        <LinearLayout
            android:id="@+id/brand_segments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/MediBook.BrandCaption"
                    android:text="@string/brand_find" />

                <TextView
                    style="@style/MediBook.BrandValue"
                    android:text="@string/brand_find_value" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/MediBook.BrandCaption"
                    android:text="@string/brand_book" />

                <TextView
                    style="@style/MediBook.BrandValue"
                    android:text="@string/brand_book_value" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/MediBook.BrandCaption"
                    android:text="@string/brand_chat" />

                <TextView
                    style="@style/MediBook.BrandValue"
                    android:text="@string/brand_chat_value" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
