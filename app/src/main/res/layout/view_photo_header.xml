<?xml version="1.0" encoding="utf-8"?>
<!-- Profile photo with a change action, used by both edit-profile screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp">

        <include
            android:id="@+id/photo_avatar"
            layout="@layout/view_avatar"
            android:layout_width="96dp"
            android:layout_height="96dp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/photo_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/photo_change"
        style="@style/Widget.MediBook.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/change_photo"
        app:icon="@drawable/ic_camera" />
</LinearLayout>
