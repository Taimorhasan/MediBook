rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && 
             (user.get('role', '').lower() == 'admin' ||
              'admin' in user.get('roleIds', []));
    }

    function hasPermission(permission) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && 
             (isAdmin() || 
              permission in user.get('permissions', []));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // Roles collection
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('manage_roles');
    }

    // Doctors collection
    match /doctors/{doctorId} {
      // Patients can only see verified doctors. Admins and Managers can see all.
      allow read: if isSignedIn() && (isAdmin() || hasPermission('manage_doctors') || resource.data.get('isVerified', false) == true);
      allow write: if isAdmin() || hasPermission('manage_doctors');
    }

    // Hospitals collection
    match /hospitals/{hospitalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('manage_hospitals');
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid || isAdmin() || hasPermission('view_reports'));
      allow write: if isSignedIn();
    }
    
    // Notifications collection
    match /notifications/{notifId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // General fallback
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
