rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && 
             (user.get('role', '').lower() == 'admin' ||
              'admin' in user.get('roleIds', []));
    }

    function hasPermission(permission) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && 
             (isAdmin() || 
              permission in user.get('permissions', []));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // Roles collection
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('manage_roles');
    }

    // Doctors collection
    match /doctors/{doctorId} {
      // Patients can only see verified doctors. Admins and Managers can see all.
      allow read: if isSignedIn() && (
        doctorId == request.auth.uid ||
        isAdmin() ||
        hasPermission('manage_doctors') ||
        resource.data.get('isVerified', false) == true
      );
      allow create: if isSignedIn()
        && doctorId == request.auth.uid
        && request.resource.data.get('isVerified', false) == false;
      allow update: if isSignedIn() && (
        isAdmin() ||
        hasPermission('manage_doctors') ||
        (
          doctorId == request.auth.uid &&
          request.resource.data.get('isVerified', false) == resource.data.get('isVerified', false) &&
          request.resource.data.get('isActive', true) == resource.data.get('isActive', true)
        )
      );
      allow delete: if isAdmin() || hasPermission('manage_doctors');
    }

    // Hospitals collection
    match /hospitals/{hospitalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('manage_hospitals');
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid || isAdmin() || hasPermission('view_reports'));
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.doctorId is string
        && request.resource.data.date is string
        && request.resource.data.slotTime is string
        && request.resource.data.status in ['pending', 'confirmed'];
      allow update: if isSignedIn()
        && (
          resource.data.patientId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid ||
          isAdmin() ||
          hasPermission('manage_appointments')
        )
        && request.resource.data.status in ['pending', 'confirmed', 'cancelled', 'completed'];
    }
    
    // Notifications collection
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId is string;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // General fallback
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
