rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user has a specific role
    function hasRole(roleName) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds.hasAny([roleName]);
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return hasRole('admin');
    }

    // Helper function to check if user is a manager
    function isManager() {
      return hasRole('manager');
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isManager());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Roles collection
    match /roles/{roleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Doctors collection
    match /doctors/{doctorId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isManager();
    }

    // Hospitals collection
    match /hospitals/{hospitalId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isManager();
    }

    // Schedules collection
    match /schedules/{scheduleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isManager();
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId || 
        isAdmin() || 
        isManager()
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.patientId || 
        isAdmin() || 
        isManager()
      );
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }
  }
}
